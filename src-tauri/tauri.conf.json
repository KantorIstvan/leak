{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leak",
  "version": "../package.json",
  "identifier": "hu.leak.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Leak",
        "width": 1280,
        "height": 840,
        "minWidth": 380,
        "minHeight": 600,
        "backgroundColor": "#0f0e0d"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://img.clerk.com",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://clerk.leakbudget.hu https://vtiyvfxahxrtpraxfync.supabase.co https://api.frankfurter.dev",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Kantor Istvan",
    "copyright": "Copyright (c) 2026 Kantor Istvan. AGPL-3.0-or-later.",
    "category": "Finance",
    "shortDescription": "Personal finance tracker built on the 50/30/20 rule",
    "longDescription": "Leak is a personal finance tracker that syncs across your devices. Record income and expenses, split them into Needs, Wants and Investments, and see how each month tracks against the 50/30/20 budget.",
    "license": "AGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["leakbudget"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA3MTg4OTg1NUM2N0RGQkYKUldTLzMyZGNoWWtZQjhkdGliZWpsUmZCSFIrZENydi95bEgzNThuc3BXY3FBSjJVRFB1eG1GckQK",
      "endpoints": [
        "https://github.com/KantorIstvan/leak/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
