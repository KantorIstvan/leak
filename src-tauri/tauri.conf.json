{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leak",
  "version": "0.1.0",
  "identifier": "hu.leak.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Leak",
        "width": 1280,
        "height": 840,
        "minWidth": 380,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Kantor Istvan",
    "copyright": "Copyright (c) 2026 Kantor Istvan. AGPL-3.0-or-later.",
    "category": "Finance",
    "shortDescription": "Personal finance tracker built on the 50/30/20 rule",
    "longDescription": "Leak is a local-first personal finance tracker. Record income and expenses, split them into Needs, Wants and Investments, and see how each month tracks against the 50/30/20 budget.",
    "license": "AGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
